{
  "name": "db-explorer",
  "productName": "DB Explorer",
  "version": "0.0.1",
  "private": true,
  "description": "Cliente de escritorio para explorar y consultar bases de datos PostgreSQL, MariaDB/MySQL, SQLite y SQL Server.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "electron-vite build && playwright test",
    "lint": "eslint . && npm run typecheck",
    "format": "prettier --write .",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/cascadia-code": "^5.3.0",
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@tanstack/react-virtual": "^3.14.13",
    "@vscode/codicons": "^0.0.46-24",
    "jsonc-parser": "^3.3.1",
    "lodash": "^4.18.1",
    "marked": "^16.4.2",
    "monaco-editor": "0.57.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "react-responsive-carousel": "^3.2.23",
    "tedious": "^20.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
